# Compose-level configuration for the self-hosted deployment.
# Copy to .env next to docker-compose.yml. Never commit the real file.

# ---------------------------------------------------------------- database
POSTGRES_USER=daj
POSTGRES_DB=daj
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- api
# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Exact origin of the admin dashboard, comma-separated if there is more than one.
# No trailing slash, no wildcard in production.
CORS_ORIGINS=https://admin.durgeshamlajuice.in

TZ_BUSINESS=Asia/Kolkata
RENEWAL_ALERT_DAYS=2
ENABLE_CRON=true
ROUTE_CRON=30 4 * * *
LOG_LEVEL=info

# ---------------------------------------------------------------- backups
# UTC time of the nightly dump, and how many days of dumps to keep locally.
BACKUP_AT=02:30
BACKUP_KEEP_DAYS=14

# ---------------------------------------------------------------- cloudflare
# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → install token.
# Only needed for: docker compose --profile tunnel up -d cloudflared
CLOUDFLARE_TUNNEL_TOKEN=
