# ---------------------------------------------------------------- core
NODE_ENV=development
PORT=4000

# Postgres connection string.
#   docker-compose: postgresql://daj:daj_dev_password@localhost:5432/daj?schema=public
#   Render:         copy the "Internal Database URL" from the managed Postgres
DATABASE_URL=postgresql://daj:daj_dev_password@localhost:5432/daj?schema=public

# ---------------------------------------------------------------- auth
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# ---------------------------------------------------------------- web
# Comma-separated list of allowed admin-web origins. No wildcard in production.
CORS_ORIGINS=http://localhost:5173
# Set true when behind Cloudflare Tunnel or Render so rate limiting sees real client IPs.
TRUST_PROXY=false

# ---------------------------------------------------------------- business rules
TZ_BUSINESS=Asia/Kolkata
# Flag a customer for renewal when this many days remain on their plan.
RENEWAL_ALERT_DAYS=2

# ---------------------------------------------------------------- scheduled jobs
ENABLE_CRON=true
# Daily route generation — 04:30 in TZ_BUSINESS.
ROUTE_CRON=30 4 * * *
# Retire finished subscriptions — 01:00 in TZ_BUSINESS.
EXPIRY_CRON=0 1 * * *

# ---------------------------------------------------------------- rate limits
RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX=10
LEADS_RATE_MAX=5

# ---------------------------------------------------------------- logging
LOG_LEVEL=info

# ---------------------------------------------------------------- seed (optional)
SEED_ADMIN_PASSWORD=ChangeMe@Admin1
SEED_SUPERVISOR_PASSWORD=ChangeMe@Super1
SEED_RIDER_PASSWORD=ChangeMe@Rider1
