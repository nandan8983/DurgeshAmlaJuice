{
  "name": "daj-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Durgesh Amla Juice \u2014 delivery management REST API",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "db:dev": "node scripts/dev-db.mjs start",
    "db:reset": "node scripts/dev-db.mjs status && prisma migrate reset --force",
    "db:status": "node scripts/dev-db.mjs status",
    "db:stop": "node scripts/dev-db.mjs stop",
    "dev": "tsx watch src/index.ts",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "start": "node dist/src/index.js",
    "test": "vitest run --exclude tests/integration/**",
    "test:all": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dayjs": "1.11.13",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "node-cron": "3.0.3",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.17.6",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "6.0.2",
    "embedded-postgres": "^18.6.0-beta.19",
    "pino-pretty": "11.3.0",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
